{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "usuarios-route": {
        "ClusterId": "usuarios-cluster",
        "Match": {
          "Path": "/usuarios/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/usuarios" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "lugares-route": {
        "ClusterId": "lugares-cluster",
        "Match": {
          "Path": "/lugares/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/lugares" }
        ]
      },
      "itinerarios-route": {
        "ClusterId": "itinerarios-cluster",
        "Match": {
          "Path": "/itinerarios/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/itinerarios" }
        ]
      },
    "usuarios-google-callback-route": {
        "ClusterId": "usuarios-cluster",
        "Match": {
            "Path": "/signin-google"
        },
        "Transforms": [
            { "RequestHeaderOriginalHost": "true" },
            { "RequestHeader": "X-Forwarded-Host", "Set": "localhost:8000" },
            { "RequestHeader": "X-Forwarded-Proto", "Set": "http" }
        ]
    },
    "usuarios-app-callback-route": {
        "ClusterId": "usuarios-cluster",
        "Match": {
            "Path": "/auth/google/callback"
        },
        "Transforms": [
            { "RequestHeaderOriginalHost": "true" }
        ]
    }
    },
    "Clusters": {
      "usuarios-cluster": {
        "Destinations": {
          "usuarios-api": {
            "Address": "http://usuarios-api:8080/"
          }
        }
      },
      "lugares-cluster": {
        "Destinations": {
          "lugares-api": {
            "Address": "http://lugares-api:8080/"
          }
        }
      },
      "itinerarios-cluster": {
        "Destinations": {
          "itinerarios-api": {
            "Address": "http://itinerarios-api:8080/"
          }
        }
      }
    }
  }
}
